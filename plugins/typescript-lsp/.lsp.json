    "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/start.sh", "${CLAUDE_PROJECT_DIR}"],
    "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
    "extensionToLanguage": {
